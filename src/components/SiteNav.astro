---
import ReadingStyle from './ReadingStyle.astro';
const { active = 'writing' } = Astro.props;
---
<header class="site-header">
  <a class="wordmark" href="/">Ideas in <em>Shuffle</em></a>
  <nav class="site-nav" aria-label="Site navigation">
    <a href="/" aria-current={active === 'writing' ? 'page' : undefined}>WRITING</a>
    <a href="/about" aria-current={active === 'about' ? 'page' : undefined}>ABOUT</a>
    <a href="/rss.xml">SUBSCRIBE</a>
    {active !== 'writing' && <ReadingStyle />}
  </nav>
</header>
