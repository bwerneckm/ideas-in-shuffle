---
import { getSortedPosts, getTagCounts, estimateReadTime, formatDate } from '../lib/posts';
import EssayEntry from './EssayEntry.astro';
import ReadingStyle from './ReadingStyle.astro';
import type { CollectionEntry } from 'astro:content';
interface Props { openPost?: CollectionEntry<'posts'>; }
const { openPost } = Astro.props;
const posts = await getSortedPosts();
const counts = await getTagCounts();
const tags = ['All', 'Fintech', 'AI', 'Business', 'Endurance'];
const isReader = !!openPost;
const minutes = openPost ? openPost.data.readMinutes || estimateReadTime(openPost.body) : 0;
---
<div class="device-wrap">
  <div class="device" id="device" data-tags={JSON.stringify(tags)}>
    <div class="screen">
      <div class="reader-toolbar">
        {isReader ? <a class="library-back" href="/">← Library</a> : <span class="toolbar-label">LIBRARY</span>}
        <ReadingStyle />
      </div>
      <main class="view" id="main-content" tabindex="0" aria-label={isReader ? 'Essay' : 'Essay library'} data-library={!isReader ? '' : undefined}>
        {openPost ? (
          <article class="article text-column" lang={openPost.data.lang}>
            <header class="article-head">
              <span class="a-kicker">{openPost.data.tag}</span>
              <h1>{openPost.data.title}</h1>
              <div class="a-meta">Breno Maximiano · <time datetime={openPost.data.date.toISOString()}>{formatDate(openPost.data.date)}</time> · {minutes} min</div>
            </header>
            <slot />
          </article>
        ) : (
          <div class="library text-column">
            <h1>Your library</h1>
            <p class="library-description">Essays on fintech infrastructure, AI tooling and business, with the occasional endurance entry. Published in English and Portuguese.</p>
            <div class="collections" role="group" aria-label="Filter essays">
              {tags.map((tag) => (
                <button type="button" data-filter={tag} aria-pressed={tag === 'All' ? 'true' : 'false'}>
                  {tag === 'All' ? 'All writing' : tag}<span class="filter-count">{tag === 'All' ? posts.length : counts[tag] || 0}</span>
                </button>
              ))}
            </div>
            <ul class="essay-list">{posts.map((post) => <EssayEntry post={post} readMinutes={post.data.readMinutes || estimateReadTime(post.body)} />)}</ul>
            <p class="library-empty" hidden>No essays in this collection yet. <button type="button" data-show-all>Browse all writing</button></p>
            <footer class="library-links"><a href="https://www.linkedin.com/in/brenomaximiano" target="_blank" rel="noopener">LinkedIn</a><a href="mailto:hello@ideasinshuffle.com">Email</a><a href="/rss.xml">RSS</a></footer>
          </div>
        )}
      </main>
      <footer class="device-footer"><span>© {new Date().getFullYear()} Breno Maximiano</span><span data-library-count aria-live="polite">{isReader ? `${minutes} min read` : `${posts.length} essays`}</span></footer>
    </div>
    <div class="chin" aria-hidden="true">IDEAS IN SHUFFLE</div>
  </div>
</div>
<script>
  const device = document.querySelector<HTMLElement>('#device');
  const tags: string[] = JSON.parse(device?.dataset.tags || '[]');
  let topic = new URLSearchParams(location.search).get('topic') || 'All';
  if (!tags.includes(topic)) topic = 'All';
  const library = document.querySelector<HTMLElement>('[data-library]');
  const entries = document.querySelectorAll<HTMLElement>('.essay-entry');
  const back = document.querySelector<HTMLAnchorElement>('.library-back');
  const libraryURL = () => topic === 'All' ? '/' : `/?topic=${encodeURIComponent(topic)}`;
  if (back) back.href = libraryURL();
  function applyFilter() {
    let count = 0;
    entries.forEach((entry) => {
      entry.hidden = topic !== 'All' && entry.dataset.tag !== topic;
      if (!entry.hidden) count++;
      const link = entry.querySelector<HTMLAnchorElement>('[data-post-link]');
      if (link) {
        const url = new URL(link.href);
        url.search = topic === 'All' ? '' : `?topic=${encodeURIComponent(topic)}`;
        link.href = url.pathname + url.search;
      }
    });
    document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.filter === topic)));
    const empty = document.querySelector<HTMLElement>('.library-empty');
    if (empty) empty.hidden = count > 0;
    const status = document.querySelector('[data-library-count]');
    if (status) status.textContent = `${count} ${count === 1 ? 'essay' : 'essays'}`;
  }
  function savePosition() {
    if (!library) return;
    try { sessionStorage.setItem(`iis-library:${topic}`, String(library.scrollTop)); } catch { /* Navigation works without storage. */ }
  }
  function selectTopic(next: string) {
    savePosition(); topic = next; applyFilter();
    history.replaceState(history.state, '', libraryURL());
    if (library) library.scrollTop = 0;
  }
  if (library) {
    applyFilter();
    let saved = 0;
    try { saved = Number(sessionStorage.getItem(`iis-library:${topic}`)) || 0; } catch { /* Use the start of the list. */ }
    const restore = () => { if (!location.hash) library.scrollTop = Math.max(0, saved); };
    restore(); document.fonts.ready.then(restore);
    document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((button) => button.addEventListener('click', () => selectTopic(button.dataset.filter || 'All')));
    document.querySelector('[data-show-all]')?.addEventListener('click', () => selectTopic('All'));
    library.addEventListener('click', (event) => { if (event.target instanceof Element && event.target.closest('[data-post-link]')) savePosition(); });
    window.addEventListener('pagehide', savePosition);
  }
</script>
